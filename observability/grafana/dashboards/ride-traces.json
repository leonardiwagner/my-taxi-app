{
  "id": null,
  "uid": "ride-traces",
  "title": "Ride trace lookup",
  "tags": ["rides", "tracing"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "rideId",
        "label": "Ride ID",
        "type": "textbox",
        "current": { "text": "", "value": "" },
        "options": [],
        "query": "",
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Traces for this ride",
      "description": "Enter a ride ID to list the traces that carry it.",
      "type": "table",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ span.rideId = \"$rideId\" }",
          "limit": 100,
          "tableType": "traces"
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "startTime", "desc": true }]
      }
    }
  ]
}
